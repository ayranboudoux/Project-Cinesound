<?xml version="1.0" encoding="utf-8"?>
<!--
    CINESOUND — TELA 6: Busca em Tempo Real
    Dados: TMDB /search/multi?query=...
    UX: TextWatcher dispara busca após 300ms de inatividade (debounce)
    RecyclerView atualiza automaticamente conforme o usuário digita
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ui.search.SearchActivity">

    <!-- =============================================
         BARRA DE BUSCA (fixa no topo)
         Botão voltar + campo de texto focado
         ============================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/spacing_12"
        android:background="@color/bg_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botão voltar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_back_search"
            app:iconTint="@color/text_primary"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:backgroundTint="@color/bg_tertiary"
            app:cornerRadius="50dp"
            android:contentDescription="@string/cd_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Campo de busca -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_input_container"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/spacing_10"
            app:cardBackgroundColor="@color/bg_tertiary"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/border_medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/spacing_12">

                <!-- Ícone de busca -->
                <ImageView
                    android:id="@+id/iv_search_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search1_catalog"
                    app:tint="@color/text_hint"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Campo de texto (auto-foca ao abrir a tela) -->
                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/search_hint"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/Syne_Regular"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:paddingStart="@dimen/spacing_10"
                    android:paddingEnd="@dimen/spacing_40"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_search_icon"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Botão limpar (X) — aparece quando há texto -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:fontFamily="@font/Syne_Regular"
                    android:visibility="gone"
                    app:icon="@drawable/ic_close_small"
                    app:iconTint="@color/text_hint"
                    app:iconSize="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:backgroundTint="@android:color/transparent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divisor -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/border_subtle"
        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- =============================================
         ESTADO: Inicial (antes de digitar)
         Sugestões de busca populares
         ============================================= -->
    <LinearLayout
        android:id="@+id/layout_initial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_20"
        android:visibility="visible"
        android:fontFamily="@font/Syne_Regular"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sugestões populares"
            android:fontFamily="@font/Syne_Bold"
            android:textSize="13sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="@dimen/spacing_12" />

        <!-- Chips de sugestão (populados via código) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_suggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/Syne_Regular"
            app:chipSpacingHorizontal="@dimen/spacing_6"
            app:chipSpacingVertical="@dimen/spacing_6">

            <!-- Chips adicionados dinamicamente via Kotlin -->

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <!-- =============================================
         ESTADO: Carregando (ProgressBar + texto)
         Visível durante a requisição à API
         ============================================= -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_40"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="Buscando..."
            android:textSize="13sp"
            android:textColor="@color/text_hint" />

    </LinearLayout>

    <!-- =============================================
         ESTADO: Vazio (nenhum resultado)
         ============================================= -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_40"
        android:visibility="gone"
        android:fontFamily="@font/Syne_Regular"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_search1_catalog"
            app:tint="@color/text_hint"
            android:alpha="0.4"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/search_empty"
            android:fontFamily="@font/Syne_Bold"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_empty_query"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:gravity="center"
            tools:text='Nenhum resultado para "xyzw"' />

    </LinearLayout>

    <!-- =============================================
         LISTA DE RESULTADOS
         item_search_result.xml para cada item
         LinearLayoutManager (VERTICAL)
         ============================================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_8"
        android:scrollbars="none"
        android:visibility="gone"
        android:fontFamily="@font/Syne_Bold"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintVertical_bias="0.0"
        tools:itemCount="6"
        tools:listitem="@layout/item_search_result"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
