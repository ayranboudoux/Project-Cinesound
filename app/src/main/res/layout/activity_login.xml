<?xml version="1.0" encoding="utf-8"?>
<!--
    CINESOUND — TELA 1: Login / Autenticação
    Layout: ConstraintLayout centralizado
    Componentes: Logo, campos email/senha, botão login,
                 link cadastro, link recuperação de senha
    Integração: FirebaseAuth (email + password)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ui.auth.LoginActivity">

    <!-- =============================================
         ScrollView: evita corte em telas menores
         ============================================= -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_24"
            android:paddingTop="@dimen/spacing_48"
            android:paddingBottom="@dimen/spacing_32">

            <!-- =============================================
                 BLOCO 1: Logo e identidade do app
                 ============================================= -->

            <!-- Ícone do logo (onda de som + filme) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/logo_icon_container"
                android:layout_width="@dimen/logo_big_size"
                android:layout_height="@dimen/logo_big_size"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="@color/accent"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_logo_wave"
                    android:contentDescription="@null"
                    app:tint="@android:color/white" />

            </androidx.cardview.widget.CardView>

            <!-- Nome do app -->
            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/Syne_Bold"
                app:layout_constraintTop_toBottomOf="@id/logo_icon_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_12" />

            <!-- Tagline -->
            <TextView
                android:id="@+id/tv_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/tv_app_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_4" />

            <!-- =============================================
                 BLOCO 2: Faixa de pôsteres decorativa
                 Exibe thumbnails de filmes populares
                 ============================================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/movie_strip_container"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginTop="@dimen/spacing_20"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardBackgroundColor="@color/bg_tertiary"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_subtle"
                app:layout_constraintTop_toBottomOf="@id/tv_tagline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- RecyclerView horizontal com pôsteres decorativos -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_poster_strip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_poster_strip"
                    tools:itemCount="8" />

            </com.google.android.material.card.MaterialCardView>

            <!-- =============================================
                 BLOCO 3: Formulário de autenticação
                 ============================================= -->

            <!-- Campo E-mail -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.CineSound.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:hint="@string/label_email"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/text_hint"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/movie_strip_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp"
                    android:imeOptions="actionNext"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo Senha -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.CineSound.TextInputLayout"
                android:layout_width="365dp"
                android:layout_height="61dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="@string/label_password"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_hint"
                app:errorEnabled="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_email"
                app:startIconDrawable="@drawable/ic_key"
                app:startIconTint="@color/text_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Link: esqueci minha senha -->

            <!-- =============================================
                 BLOCO 4: Botão de login
                 ============================================= -->

            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="120dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="@dimen/spacing_8"
                android:text="@string/link_forgot_password"
                android:textColor="@color/accent_light"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_password" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/btn_login"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:letterSpacing="0.02"
                app:backgroundTint="@color/accent"
                app:cornerRadius="@dimen/radius_medium"
                app:elevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tv_forgot_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ProgressBar (visível apenas durante o login) -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                android:indeterminateTint="@color/accent"
                app:layout_constraintTop_toTopOf="@id/btn_login"
                app:layout_constraintBottom_toBottomOf="@id/btn_login"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Divisor visual -->
            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_20"
                android:background="@color/border_subtle"
                app:layout_constraintTop_toBottomOf="@id/btn_login"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- =============================================
                 BLOCO 5: Link para cadastro
                 ============================================= -->
            <TextView
                android:id="@+id/tv_create_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_create_account"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:paddingVertical="@dimen/spacing_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintTop_toBottomOf="@id/divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- =============================================
                 BLOCO 6: Rodapé com termos e versão
                 ============================================= -->
            <TextView
                android:id="@+id/tv_terms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/login_terms"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                app:layout_constraintTop_toBottomOf="@id/tv_create_account"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/app_version"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                app:layout_constraintTop_toBottomOf="@id/tv_terms"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
