<?xml version="1.0" encoding="utf-8"?>
<!--
    CINESOUND — TELA 5: Catálogo Geral
    Dados: TMDB API com filtros múltiplos
    Layout: Logo + SearchBar + Filtros expansíveis + Grid 2 colunas
    Chips de filtro: Tipo, Gênero, Ordenação
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/catalog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ui.catalogo.CatalogoFragment">

    <!-- =============================================
         TOOLBAR com logo
         ============================================= -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/bg_primary"
        android:paddingHorizontal="@dimen/spacing_16"
        android:fontFamily="@font/syne_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/logo_icon"
                android:layout_width="@dimen/logo_size"
                android:layout_height="@dimen/logo_size"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/accent"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_logo_wave"
                    android:contentDescription="@null"
                    app:tint="@android:color/white" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_logo_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/syne_bold"
                android:layout_marginStart="@dimen/spacing_8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/logo_icon" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- =============================================
         BARRA DE BUSCA com botão "Random"
         ============================================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_bar_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/search_height"
        android:layout_marginHorizontal="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_8"
        android:fontFamily="@font/syne_bold"
        app:cardBackgroundColor="@color/bg_tertiary"
        app:cardCornerRadius="@dimen/radius_medium"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/border_medium"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/spacing_12">

            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search1_catalog"
                app:tint="@color/text_hint"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/catalog_hint_search"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:paddingStart="@dimen/spacing_10"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_search_icon"
                app:layout_constraintEnd_toStartOf="@id/btn_random" />

            <!-- Botão Random: abre título aleatório -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_random"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="@dimen/spacing_6"
                android:text="@string/catalog_btn_random"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:fontFamily="@font/syne_bold"
                android:paddingHorizontal="@dimen/spacing_12"
                app:backgroundTint="@color/accent"
                app:cornerRadius="@dimen/radius_small"
                app:elevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- =============================================
         PAINEL DE FILTROS
         Seções: Tipo, Gênero, Organizar
         Cada seção tem uma label + ChipGroup scrollável
         ============================================= -->
    <LinearLayout
        android:id="@+id/filter_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/spacing_10"
        android:paddingHorizontal="@dimen/spacing_16"
        android:fontFamily="@font/syne_regular"
        app:layout_constraintTop_toBottomOf="@id/search_bar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Filtro: Tipo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_tipo"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:fontFamily="@font/syne_regular"
            android:layout_marginBottom="@dimen/spacing_6"
            />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fontFamily="@font/syne_regular"
            android:layout_marginBottom="@dimen/spacing_10">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_movies"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/filter_movies"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_series"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/filter_series" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_all"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_anime"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Anime" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Filtro: Gênero -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_genero"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="@dimen/spacing_6" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="@dimen/spacing_10">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_genre_action"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/genre_action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_genre_drama"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/genre_drama" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_genre_scifi"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/genre_scifi" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_genre_horror"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/genre_horror" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_genre_comedy"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/genre_comedy" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_genre_animation"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/genre_animation" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_genre_crime"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/genre_crime" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Filtro: Ordenação -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_ordenar"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="@dimen/spacing_6" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="@dimen/spacing_8">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_az"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/filter_az"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_rating"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/filter_rating" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_newest"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/filter_newest" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_popular"
                    style="@style/Widget.CineSound.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Popular" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

    </LinearLayout>

    <!-- =============================================
         GRID: RecyclerView 2 colunas
         item_catalog_card.xml para cada título
         GridLayoutManager(2)
         ============================================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_catalog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_16"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/filter_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_catalog_card"
        tools:itemCount="6" />

</androidx.constraintlayout.widget.ConstraintLayout>