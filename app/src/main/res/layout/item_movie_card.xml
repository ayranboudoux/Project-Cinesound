<?xml version="1.0" encoding="utf-8"?>
<!--
    CINESOUND — Item: Card de Filme/Série (lista vertical)
    Usado em: HomeFragment (recomendações)
    Estrutura: pôster pequeno à esquerda + infos à direita + badge de nota
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_subtle"
    app:rippleColor="@color/border_medium">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_12">

        <!-- Pôster do título (carregado via Glide) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_poster"
            android:layout_width="@dimen/poster_small_width"
            android:layout_height="@dimen/poster_small_height"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardBackgroundColor="@color/bg_tertiary"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/iv_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:src="@tools:sample/backgrounds/scenic" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Título -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/Syne_Bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_poster"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Noites de Aurora" />

        <!-- Gênero · Ano -->
        <TextView
            android:id="@+id/tv_genre_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginTop="@dimen/spacing_4"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:fontFamily="@font/Syne_Regular"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toEndOf="@id/card_poster"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Gênero · Ano" />

        <!-- Descrição / motivo da recomendação -->
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginTop="@dimen/spacing_6"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.5"
            android:maxLines="3"
            android:ellipsize="end"
            android:fontFamily="@font/Syne_Medium"
            app:layout_constraintTop_toBottomOf="@id/tv_genre_year"
            app:layout_constraintStart_toEndOf="@id/card_poster"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Recomendado para você que gostou de filmes deste gênero." />

        <!-- Linha inferior: rating + tag de categoria -->
        <LinearLayout
            android:id="@+id/row_badges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginTop="@dimen/spacing_8"
            android:fontFamily="@font/Syne_Regular"
            app:layout_constraintTop_toBottomOf="@id/tv_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_poster"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Badge de nota IMDb/TMDB -->
            <LinearLayout
                android:id="@+id/badge_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_rating"
                android:paddingHorizontal="@dimen/spacing_8"
                android:paddingVertical="@dimen/spacing_4"
                android:fontFamily="@font/Syne_Regular"
                >

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star_1_details"
                    app:tint="@color/yellow_star"
                    android:contentDescription="@null"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/tv_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/yellow_star"
                    tools:text="8.2" />

            </LinearLayout>

            <!-- Tag de categoria (Tendências, Top Rated, Popular) -->
            <TextView
                android:id="@+id/tv_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_6"
                android:background="@drawable/bg_badge_tag"
                android:paddingHorizontal="@dimen/spacing_8"
                android:paddingVertical="@dimen/spacing_4"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/accent_light"
                android:visibility="gone"
                android:fontFamily="@font/Syne_Regular"
                tools:text="Tendências"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
