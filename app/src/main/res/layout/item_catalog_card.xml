<?xml version="1.0" encoding="utf-8"?>
<!--
    CINESOUND — Item: Card do Catálogo (grid 2 colunas)
    Usado em: CatalogFragment (GridLayoutManager spanCount=2)
    Estrutura: pôster grande em aspect-ratio 2:3 + badge de nota sobreposto
               + info abaixo: título, gênero, estrela + ano
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_6"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_subtle"
    app:rippleColor="@color/border_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Área da imagem (aspect ratio 2:3 via paddingTop percentual) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Container com aspect ratio fixo -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- "Espaçador" invisible para forçar ratio 2:3 -->
                <View
                    android:id="@+id/aspect_ratio_view"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintDimensionRatio="2:3" />

                <!-- Pôster do título -->
                <ImageView
                    android:id="@+id/iv_poster"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="@id/aspect_ratio_view"
                    app:layout_constraintBottom_toBottomOf="@id/aspect_ratio_view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:src="@tools:sample/backgrounds/scenic" />

                <!-- Gradiente escuro na parte inferior do pôster -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/gradient_poster_bottom"
                    app:layout_constraintBottom_toBottomOf="@id/aspect_ratio_view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Badge de nota (canto superior esquerdo) -->
                <LinearLayout
                    android:id="@+id/badge_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_badge_dark"
                    android:paddingHorizontal="@dimen/spacing_6"
                    android:paddingVertical="@dimen/spacing_4"
                    android:layout_margin="@dimen/spacing_8"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/yellow_star"
                        tools:text="8.9" />

                </LinearLayout>

                <!-- Botão play (canto superior direito) -->
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_play_button"
                    android:layout_margin="@dimen/spacing_8"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_arrow"
                        app:tint="@android:color/white"
                        android:contentDescription="@null" />

                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

        <!-- Área de informações abaixo do pôster -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_10">

            <!-- Título -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="@dimen/spacing_4"
                tools:text="Horizonte de Neon" />

            <!-- Gênero -->
            <TextView
                android:id="@+id/tv_genre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="@dimen/spacing_6"
                tools:text="Ficção científica · Ação" />

            <!-- Linha: estrela + ano -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="@color/yellow_star"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/spacing_4" />

                <TextView
                    android:id="@+id/tv_rating_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    tools:text="8,9" />

                <TextView
                    android:id="@+id/tv_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    tools:text="2024" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
