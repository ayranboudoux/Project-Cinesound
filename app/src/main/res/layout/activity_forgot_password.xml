<?xml version="1.0" encoding="utf-8"?>
<!--
    CINESOUND — TELA 2: Recuperação de Senha
    Integração: FirebaseAuth.sendPasswordResetEmail()
    UX: Feedback inline de sucesso/erro com animação
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forgot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ui.auth.ForgotPasswordActivity">

    <!-- Botão voltar no topo (fora do scroll para ficar fixo) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_16"
        app:icon="@drawable/ic_back_forgot_password"
        app:iconTint="@color/text_primary"
        app:iconSize="22dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:contentDescription="@string/cd_back"
        app:backgroundTint="@color/bg_tertiary"
        app:cornerRadius="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_24"
            android:paddingTop="@dimen/spacing_32"
            android:paddingBottom="@dimen/spacing_40">

            <!-- =============================================
                 Ilustração / ícone de e-mail
                 ============================================= -->
            <androidx.cardview.widget.CardView
                android:id="@+id/icon_container"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/accent_surface"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_email_outline"
                    app:tint="@color/accent" />

            </androidx.cardview.widget.CardView>

            <!-- Título da tela -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/forgot_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/Syne_Bold"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/icon_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Texto explicativo -->

            <!-- =============================================
                 Campo de e-mail
                 ============================================= -->
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/forgot_description"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/Syne_Regular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.CineSound.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32"
                android:hint="@string/label_email"
                android:fontFamily="@font/Syne_Regular"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/text_hint"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/tv_description"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp"
                    android:imeOptions="actionDone"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- =============================================
                 Card de feedback (sucesso/erro) — gone por padrão
                 Exibido após tentar enviar o link
                 ============================================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_feedback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:visibility="gone"
                app:cardBackgroundColor="@color/accent_surface"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/accent"
                app:layout_constraintTop_toBottomOf="@id/til_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_12"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_feedback_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_checkforgotpassword"
                        app:tint="@color/green_positive" />

                    <TextView
                        android:id="@+id/tv_feedback"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_10"
                        android:text="@string/forgot_success"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingMultiplier="1.4"
                        android:fontFamily="@font/Syne_Regular"
                        tools:text="@string/forgot_success" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- =============================================
                 Botão enviar link de recuperação
                 ============================================= -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_recovery"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/btn_send_recovery"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/accent"
                app:cornerRadius="@dimen/radius_medium"
                app:elevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_feedback"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ProgressBar durante envio -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:visibility="gone"
                android:indeterminateTint="@color/accent"
                app:layout_constraintTop_toTopOf="@id/btn_send_recovery"
                app:layout_constraintBottom_toBottomOf="@id/btn_send_recovery"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Link: voltar para login -->
            <TextView
                android:id="@+id/tv_back_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/btn_back_to_login"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:paddingVertical="@dimen/spacing_8"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintTop_toBottomOf="@id/btn_send_recovery"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
