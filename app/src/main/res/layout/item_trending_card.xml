<?xml version="1.0" encoding="utf-8"?>
<!--
    CINESOUND — Item: Card de Trending (ranking semanal)
    Usado em: TrendingFragment
    Diferencial: badge de posição (#1, #2, #3 com cores especiais)
    Top 1 → borda dourada, Top 2 → prata, Top 3 → bronze
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_subtle"
    app:rippleColor="@color/border_medium">

    <!--
        NOTA: No Kotlin, para os 3 primeiros itens altere a strokeColor:
          Top 1: "#40FFD700" (dourado)
          Top 2: "#33C0C0C0" (prata)
          Top 3: "#33CD7F32" (bronze)
        card_root.strokeColor = Color.parseColor("#40FFD700")
    -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_12">

        <!-- Badge da posição no ranking -->
        <TextView
            android:id="@+id/tv_rank"
            android:layout_width="@dimen/rank_badge_size"
            android:layout_height="@dimen/rank_badge_size"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_rank_badge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="#1" />

        <!-- Pôster do título -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_poster"
            android:layout_width="@dimen/poster_small_width"
            android:layout_height="@dimen/poster_small_height"
            android:layout_marginStart="@dimen/spacing_10"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardBackgroundColor="@color/bg_tertiary"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_rank">

            <ImageView
                android:id="@+id/iv_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:src="@tools:sample/backgrounds/scenic" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Bloco de informações -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_poster"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Título -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/syne_bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Ecos da Meia-Noite" />

            <!-- Gênero · Ano -->
            <TextView
                android:id="@+id/tv_genre_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                tools:text="Neo-noir psicológico · 2026" />

            <!-- Sinopse resumida -->
            <TextView
                android:id="@+id/tv_synopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.5"
                android:maxLines="3"
                android:ellipsize="end"
                tools:text="A haunting, slow-burn mystery recommended for fans of atmospheric thrillers and layered storytelling." />

            <!-- Linha: nota + tag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_8">

                <!-- Nota IMDb -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_badge_rating"
                    android:paddingHorizontal="@dimen/spacing_8"
                    android:paddingVertical="@dimen/spacing_4">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/yellow_star"
                        android:contentDescription="@null"
                        android:layout_marginEnd="3dp" />

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/yellow_star"
                        tools:text="8.7" />

                </LinearLayout>

                <!-- Tag (Tendências / Top Rated / Popular) -->
                <TextView
                    android:id="@+id/tv_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_6"
                    android:background="@drawable/bg_badge_tag"
                    android:paddingHorizontal="@dimen/spacing_8"
                    android:paddingVertical="@dimen/spacing_4"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_light"
                    tools:text="Tendências" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
